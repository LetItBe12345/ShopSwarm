{
  "name": "shopswarm",
  "version": "0.1.0",
  "description": "A DSH-loadable general shopping research plugin with browser and Jev support",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LetItBe12345/ShopSwarm.git"
  },
  "homepage": "https://github.com/LetItBe12345/ShopSwarm#readme",
  "bugs": {
    "url": "https://github.com/LetItBe12345/ShopSwarm/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "11.7.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "smoke:browser": "tsx scripts/smoke-browser.ts",
    "smoke:jev": "node --env-file-if-exists=.env --import tsx scripts/smoke-jev.ts",
    "smoke:shopping": "node --env-file-if-exists=.env --import tsx scripts/smoke-shopping.ts",
    "smoke:shopping-tool": "node --env-file-if-exists=.env --import tsx scripts/smoke-shopping-tool.ts",
    "e2e:dsh-plugin": "node --env-file-if-exists=.env --import tsx scripts/e2e-dsh-plugin.ts",
    "benchmark:cases": "node --import tsx scripts/benchmark-cases.ts",
    "acceptance:m0": "node --env-file-if-exists=.env --import tsx scripts/m0-acceptance.ts",
    "install:dsh": "node --import tsx scripts/install-dsh-plugin.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "agent-browser": "0.38.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-agent": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.2",
    "@types/node": "24.10.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
