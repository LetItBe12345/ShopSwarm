  "cards": [
    {
      "dot": "cyan",
      "title": "DSH 管理并行",
      "items": [
        "Lead 分发站点任务；各 Subagent 调用插件",
        "插件的一次调用可执行多轮浏览器动作"
      ]
    },
    {
      "dot": "amber",
      "title": "所有退出路径",
      "items": [
        "阻塞、超时、失败和取消均返回原因与已有进度",
        "返回前释放所属会话；DONE 不等于成功"
      ]
    }
  ]
